(type Value (primitive Value))
(type Kind
  (enum Small
        (Big (size Value))))
(extern const $ZERO Value)
(decl iconst (Value) Value)
(extern extractor iconst iconst_etor)
;; Simplify.
(decl pure simplify (Value) Value)
(decl other (Value) Value)
(rule (simplify (iconst c))
      c)
(rule first 2 (simplify x) x)
(rule (other x) x)
(rule (elsewhere x) x)
(; block
   comment ;)
