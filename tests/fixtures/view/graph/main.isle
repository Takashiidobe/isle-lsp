(decl a (u32) u32)
(decl b (u32) u32)
(decl rec c (u32) u32)
(decl ext (u32) u32)
(extern constructor ext ext)
(rule (a x) (b x))
(rule (b x) (c x))
(rule (c x) (c (ext x)))
(rule low 1 (c 0) 0)
