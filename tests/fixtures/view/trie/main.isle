(type Op (enum (Add (a u32) (b u32)) (Neg (a u32)) (Zero)))
(decl lower (Op) u32)
(decl emit_add (u32 u32) u32)
(extern constructor emit_add emit_add)
(decl emit_neg (u32) u32)
(extern constructor emit_neg emit_neg)
(rule add_zero 1 (lower (Op.Add x 0)) x)
(rule (lower (Op.Add x y)) (emit_add x y))
(rule (lower (Op.Neg x)) (emit_neg x))
(rule (lower (Op.Zero)) 0)
(rule add_self 2 (lower (Op.Add x x)) (emit_add x x))
