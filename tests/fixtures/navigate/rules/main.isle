(type Value (primitive Value))
(decl simplify (Value) Value)
;     ^ rules
(rule (simplify (iadd x y)) y)
(rule 1 (simplify (iadd x (iconst 0))) x)
(rule 2 (simplify (isub x x)) (iconst 0))
(decl lonely (Value) Value)
