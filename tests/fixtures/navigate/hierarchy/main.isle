(decl top (u32) u32)
;     ^ incoming
;     ^ outgoing
(decl mid (u32) u32)
;     ^ incoming
;     ^ outgoing
(decl rec leaf (u32) u32)
;          ^ incoming
;          ^ outgoing
(decl ext (u32) u32)
;     ^ incoming
;     ^ outgoing
(decl even (u32) u32)
;     ^ incoming
;     ^ outgoing
(decl odd (u32) u32)
;     ^ outgoing
(decl lonely (u32) u32)
;     ^ incoming
;     ^ outgoing
(extern constructor ext ext)
(macro (twice x) (mid (mid x)))
;        ^ incoming
;        ^ outgoing
(rule (top x) (mid (twice x)))
(rule (mid x) (leaf (ext x)))
(rule (leaf 0) 0)
(rule 1 (leaf x) (leaf x))
(rule (even x) (odd x))
(rule (odd x) (even x))
