(type Value (primitive Value))
(decl simplify (Value) Value)
(decl iadd (Value Value) Value)
(extern extractor infallible iadd iadd_extract)
(extern constructor iadd iadd_ctor)
(decl isub (Value Value) Value)
(extern extractor infallible isub isub_extract)
(extern constructor isub isub_ctor)
(decl ineg (Value) Value)
(extern extractor infallible ineg ineg_extract)
(extern constructor ineg ineg_ctor)
(decl iconst (u64) Value)
(extern extractor infallible iconst iconst_extract)
(extern constructor iconst iconst_ctor)
(rule iadd_x_plus_zero (simplify (iadd ty x (iconst_u ty 0))) (subsume x))
;  ^ filetest
(rule (simplify (isub ty (iconst_u ty 0) x)) (ineg ty x))
;  ^ filetest
(rule (simplify (isub ty x x)) (subsume (iconst_u ty 0)))
;  ^ filetest
(rule (simplify (iadd ty x (iconst_u ty c))) (iadd ty (iconst_u ty c) x))
;  ^ filetest
(rule (simplify (isub ty x (ineg ty y))) (iadd ty x y))
;  ^ filetest
(rule (simplify (ineg ty (ineg ty x))) (if-let y x) y)
;  ^ filetest
(rule (simplify (iadd ty x (ineg ty (ineg ty y)))) (iadd ty (isub ty x y) (iconst_u ty 1)))
;  ^ filetest
(decl other () Value)
;  ^ filetest
