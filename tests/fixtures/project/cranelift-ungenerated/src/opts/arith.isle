; mode: project, resolve
; check: === project ===
; nextln: origin: cranelift-opt
; nextln: set: opt
; nextln: files:
; nextln: project/cranelift-ungenerated/src/prelude.isle
; nextln: project/cranelift-ungenerated/src/prelude_opt.isle
; nextln: project/cranelift-ungenerated/src/opts/arith.isle
; nextln: <bundled>/numerics.isle
; nextln: <bundled>/clif_opt.isle
; check: simplify (project/cranelift-ungenerated/src/opts/arith.isle:1)
; check: iadd (<bundled>/clif_opt.isle:
; check: === resolve ===
; check: <bundled>/clif_opt.isle
(decl simplify (Value) Value)
(rule (simplify (iadd x (iconst 0))) x)
;                ^ resolve
