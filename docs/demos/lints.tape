Output docs/demos/out/lints-terminal.webm
Set Shell "bash"
Set FontSize 18
Set Width 1400
Set Height 800
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms

Type~ "nvim -n -i NONE docs/demos/isle/lints/lints.isle"
Enter
Hide
Sleep 2500ms
Type "gg"
Show
Sleep 1500ms
Type "]d"
Type " e"
Sleep 2500ms
Type "]d"
Type " e"
Sleep 2500ms
Type "]d"
Type " e"
Sleep 2500ms
Type ":18"
Enter
Sleep 800ms
Type " a"
Sleep 1500ms
Down 2
Sleep 800ms
Enter
Sleep 1500ms
Type~ ":b add_zero"
Enter
Sleep 3500ms
