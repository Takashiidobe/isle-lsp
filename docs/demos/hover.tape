Output docs/demos/out/hover-terminal.webm
Set Shell "bash"
Set FontSize 18
Set Width 1400
Set Height 800
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms

Type~ "nvim -n -i NONE docs/demos/isle/tour/tour.isle"
Enter
Hide
Sleep 2500ms
Type ":25"
Enter
Type "$F(l"
Show
Sleep 1500ms
Type "K"
Sleep 3500ms
Type ":26"
Enter
Type "$hh"
Sleep 800ms
Type "K"
Sleep 3000ms
Type ":26"
Enter
Type "0fA"
Sleep 800ms
Type "K"
Sleep 3000ms
