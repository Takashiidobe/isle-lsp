Output docs/demos/out/diagnostics-terminal.webm
Set Shell "bash"
Set FontSize 18
Set Width 1400
Set Height 800
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms

Type~ "nvim -n -i NONE docs/demos/isle/diagnostics/diagnostics.isle"
Enter
Hide
Sleep 2500ms
Type "gg"
Show
Sleep 2000ms
Type "]d"
Sleep 1500ms
Type "gra"
Sleep 1500ms
Enter
Sleep 2500ms
Type "gg"
Type "]d"
Sleep 2000ms
Type "gra"
Sleep 1500ms
Enter
Sleep 3000ms
