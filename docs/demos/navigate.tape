Output docs/demos/out/navigate-terminal.webm
Set Shell "bash"
Set FontSize 18
Set Width 1400
Set Height 800
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms

Type~ "nvim -n -i NONE docs/demos/isle/tour/tour.isle"
Enter
Hide
Sleep 2500ms
Type ":25"
Enter
Type "$F(l"
Show
Sleep 1500ms
Type "gd"
Sleep 2500ms
Type "gr"
Sleep 3000ms
Escape
Sleep 500ms
Type " r"
Sleep 1000ms
Ctrl+u
Type~ "twice"
Sleep 800ms
Enter
Sleep 3000ms
Type "gr"
Sleep 3000ms
