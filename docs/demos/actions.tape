Output docs/demos/out/actions-terminal.webm
Set Shell "bash"
Set FontSize 18
Set Width 1400
Set Height 800
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms

Type~ "nvim -n -i NONE docs/demos/isle/tour/tour.isle"
Enter
Hide
Sleep 2500ms
Type ":25"
Enter
Type "$F(l"
Show
Sleep 1500ms
Type "ga"
Sleep 1500ms
Type~ "Inline"
Sleep 1500ms
Enter
Sleep 2500ms
Type ":24"
Enter
Sleep 800ms
Type "ga"
Sleep 1500ms
Type~ "Name rule"
Sleep 1500ms
Enter
Sleep 2500ms
Type ":22"
Enter
Type "fu"
Sleep 800ms
Type "ga"
Sleep 1500ms
Type~ "Remove"
Sleep 1500ms
Enter
Sleep 2500ms
