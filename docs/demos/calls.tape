Output docs/demos/out/calls-terminal.webm
Set Shell "bash"
Set FontSize 18
Set Width 1400
Set Height 800
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms

Type~ "nvim -n -i NONE docs/demos/isle/calls/calls.isle"
Enter
Hide
Sleep 2500ms
Type ":3"
Enter
Type "ff"
Show
Sleep 1500ms
Type " ci"
Sleep 3500ms
Escape
Sleep 800ms
Type ":1"
Enter
Type "fp"
Sleep 800ms
Type " co"
Sleep 3500ms
